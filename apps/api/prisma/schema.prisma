generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String?
  name             String
  birthDate        DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  role             Role           @default(PLAYER)
  googleSub        String?        @unique
  pictureUrl       String?
  organizedLobbies Lobby[]        @relation("OrganizedLobbies")
  lobbyPlayers     LobbyPlayer[]
  refreshToken     RefreshToken[]
  rosterEntries    RosterEntry[]
}

model Lobby {
  id            String        @id @default(uuid())
  location      String
  // The Postgres column is still "hostId": renaming it would need its own
  // expand/contract migration, so @map keeps the database unchanged.
  organizerId   String        @map("hostId")
  allowToApply  Boolean
  createdAt     DateTime      @default(now())
  endTime       DateTime
  genderFormat  GenderFormat
  lobbyName     String
  price         Float
  skillLevel    SkillLevel
  startTime     DateTime
  format        LobbyFormat   @default(PICKUP)
  organizer     User          @relation("OrganizedLobbies", fields: [organizerId], references: [id])
  pools         Pool[]
  teams         Team[]
  players       LobbyPlayer[]
  rosterEntries RosterEntry[]
}

model Pool {
  id          String      @id @default(uuid())
  lobbyId     String
  name        String
  teams        Team[]
  lobby       Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, name])
}

model Team {
  id            String        @id @default(uuid())
  lobbyId       String
  name          String
  poolId        String?
  seed          Int?
  lobby         Lobby         @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  pool          Pool?          @relation(fields: [poolId], references: [id], onDelete: SetNull)
  rosterEntries RosterEntry[]
  captainName   String?

  @@unique([lobbyId, name])
  @@unique([lobbyId, seed])
  @@index([poolId])
}

model RosterEntry {
  id           String  @id @default(uuid())
  lobbyId      String
  name         String
  teamId       String?
  jerseyNumber Int?
  userId       String?
  lobby        Lobby   @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  team         Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([lobbyId, userId])
  @@index([teamId])
}

model LobbyPlayer {
  id        String   @id @default(uuid())
  lobbyId   String
  userId    String?
  guestName String?
  position  String   @default("")
  approved  Boolean  @default(false)
  paid      Boolean  @default(false)
  joinedAt  DateTime @default(now())
  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([lobbyId, userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
}

enum LobbyFormat {
  PICKUP
  TOURNAMENT
}

enum SkillLevel {
  OPEN
  INTERMEDIATE
  INTERMEDIATE_PLUS
}

enum GenderFormat {
  MENS
  WOMENS
  COED
}
